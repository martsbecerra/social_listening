# ==========================================================================
# Copiá este archivo como ".env" (sin ".example") y completá los valores.
# NUNCA subas el .env a git ni lo compartas: contiene tus claves secretas.
# ==========================================================================

# Token de la API de Apify (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=

# Cuántas corridas de Apify puede tener esta app en vuelo a la vez. Apify
# limita los Actor runs simultáneos y la memoria total según el plan
# (consola de Apify: Settings → Limits); la detección del monitoreo lanza
# todas las fuentes juntas y, sin este tope, en el plan Free (5 runs) varias
# fallaban con 402 concurrent-runs-limit-exceeded. TODAS las llamadas a
# Apify (detección, benchmark, refresco, análisis a demanda, validación de
# cuentas) pasan por la misma cola (src/apify.js). 10 (era 3): con el plan
# pago corrió ciclos reales sin un solo 402 y el ciclo dura la mitad. Si tu
# plan permite menos, bajalo; si permite más, subilo.
APIFY_MAX_CONCURRENT=10

# Si igual llega un 402 por runs simultáneos (otro proceso con el mismo
# token, o el tope de arriba demasiado alto), esa llamada espera esto (en
# milisegundos) y reintenta UNA vez antes de fallar. Opcional.
APIFY_RETRY_DELAY_MS=5000

# Timeout de seguridad por llamada a Apify (milisegundos): si runActorSync
# no termina en este plazo (arrancar el run, esperar, bajar el dataset),
# se corta con code TIMEOUT, se libera el cupo del limitador y esa cuenta u
# hashtag queda sin datos este ciclo, sin colgar el resto (un ciclo real se
# colgó ~30 min sin esto y hubo que matar el proceso a mano). Se aplica a
# cada intento por separado (el inicial y el único reintento por 402). Piso
# de 1000ms: nunca se deja en un valor tan bajo que toda llamada falle sola.
# 5 minutos (era 2): hubo consultas reales de más de 100 s. Es un tope
# contra el cuelgue, no contra una consulta lenta. Desde noviembre 2026 una
# llamada del actor apidojo que pasa el tope ya no pierde su corrida: la
# fila de apify_calls queda con el id del run (el costo se concilia igual).
# Las BÚSQUEDAS del monitoreo no usan este tope sino SEARCH_WAIT_MS (abajo):
# si no terminan a tiempo quedan esperando y se levantan en la corrida
# siguiente.
APIFY_CALL_TIMEOUT_MS=300000

# Cuánto cobra Apify por cada 1000 resultados devueltos, según el plan
# (actualizar si Apify cambia los precios). Con esto la app mide lo que
# gasta de verdad: cada llamada queda en la tabla apify_calls y cada ciclo
# en monitoring_runs (ver src/apifyCost.js), y `npm run costo` o
# GET /api/monitoring/costs muestran el gasto con las tres tarifas a la vez.
APIFY_RATE_FREE=2.70
APIFY_RATE_STARTER=2.30
APIFY_RATE_SCALE=1.90
# Plan activo (free | starter | scale): con su tarifa se llena la columna usd
# de apify_calls y monitoring_runs y el total de la línea "[costo] ciclo #N".
APIFY_PLAN=starter

# Actor de Apify para el MONITOREO de Instagram (detección, benchmark,
# refresco de métricas, validación de cuentas y hashtags, script de
# recálculo). Ver src/platforms/igActor.js.
#   apidojo (default) -> apidojo/instagram-scraper-api: cobra por consulta
#                        con posteos incluidos (APIDOJO_* abajo), trae los
#                        seguidores en cada posteo y busca por palabra clave.
#   apify             -> apify/instagram-scraper, el de siempre: cobra por
#                        resultado (APIFY_RATE_*), sin búsqueda por palabra
#                        clave. Con este valor todo funciona como antes.
# El ANÁLISIS de una publicación (comentarios) sigue siempre con
# apify/instagram-scraper: el otro actor no devuelve comentarios. Un valor
# desconocido aborta el arranque.
IG_ACTOR=apidojo

# Qué cobra apidojo por cada consulta (USD), cuántos posteos incluye cada
# una y cuánto cuesta cada posteo de más (USD). Con esto se estima el usd
# de cada llamada; el costo REAL lo devuelve Apify (ver APIFY_REAL_COST).
APIDOJO_RATE_USER=0.005
APIDOJO_RATE_HASHTAG=0.015
APIDOJO_RATE_SEARCH=0.015
APIDOJO_RATE_POST=0.005
APIDOJO_RATE_ITEM=0.0005
APIDOJO_INCLUDED_USER=10
APIDOJO_INCLUDED_HASHTAG=30
# La búsqueda NO incluye posteos: cada resultado se cobra desde el primero
# (0,015 + 0,0005 por resultado). Medido en noviembre 2026 sobre 388
# búsquedas conciliadas: con los 20 "incluidos" de la pestaña de precios el
# estimado daba 6 % menos que lo que cobró Apify.
APIDOJO_INCLUDED_SEARCH=0

# Costo real por run (solo con el actor apidojo): las llamadas van por el
# flujo asincrónico de Apify (arrancar el run, esperar y bajar sus items:
# dos o tres requests en vez de una, sin costo extra) para guardar el id
# del run. Como Apify asienta el cobro con demora, usd_real se concilia
# después: al cerrar cada ciclo se releen (gratis) los runs de las llamadas
# de más de 10 minutos, y `node scripts/costo-apify.js --conciliar` lo hace
# a mano. Los reportes prefieren usd_real al estimado. 0 lo apaga y vuelve
# al endpoint sincrónico (sin run id ni costo real).
APIFY_REAL_COST=1

# ==========================================================================
# Proveedor del LLM (análisis, clasificador del monitoreo, reclamos, importador)
# --------------------------------------------------------------------------
# El ANÁLISIS de una publicación de X usa Grok (OPENROUTER_X_MODEL) aparte;
# todo lo demás (análisis de Instagram, clasificación del monitoreo de todas
# las redes, subcategoría de reclamos, importador) usa este proveedor con UN
# solo modelo.
# Valores válidos: anthropic | openrouter. Cualquier otro valor (o un typo)
# aborta el arranque en vez de caer en un default silencioso.
#
# El modelo es el mismo en ambos proveedores — sólo cambia el formato del
# identificador: OpenRouter prefija con el proveedor (verificado contra
# https://openrouter.ai/api/v1/models):
#
#   anthropic          | openrouter
#   -------------------+---------------------------------
#   claude-sonnet-5    | anthropic/claude-sonnet-5
#
# Ese es el default del código (src/llm/providerConfig.js): si dejás la
# variable de modelo vacía, cambiar de proveedor NO cambia qué modelo se usa.
# Las variables de abajo sólo hacen falta para pisarlo.
#
# CLASSIFIER_MODEL y OPENROUTER_CLASSIFIER_MODEL (el modelo clasificador
# aparte, Haiku, de antes de septiembre 2026) ya no existen: si siguen en tu
# .env se ignoran, con un aviso al arrancar.
# ==========================================================================
LLM_PROVIDER=anthropic

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
# Clave: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo (análisis de publicación y clasificador del monitoreo). Recomendado: claude-sonnet-5.
#   - claude-haiku-4-5  -> más económico (puede perder matices/ironía)
#   - claude-sonnet-5   -> recomendado
#   - claude-opus-4-8   -> máxima calidad (más caro)
CLAUDE_MODEL=claude-sonnet-5

# --- OpenRouter (si LLM_PROVIDER=openrouter) ---
# Clave: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Base de la API. OpenRouter es compatible con OpenAI, así que esto también
# sirve para apuntar a cualquier otro gateway compatible.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo en OpenRouter (equivalente a CLAUDE_MODEL: análisis y clasificador
# del monitoreo). Debe soportar structured outputs — verificalo en
# https://openrouter.ai/models (el modelo tiene que listar
# "structured_outputs"). Vacío = el default de arriba, anthropic/claude-sonnet-5.
OPENROUTER_MODEL=

# Headers que OpenRouter recomienda para identificar la app (opcionales:
# sirven para los rankings de openrouter.ai). Si los dejás vacíos, el código
# manda X-Title: "Social Listening App" y HTTP-Referer: http://localhost:PORT.
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=

# --- Grok para X (OpenRouter; no pisa Instagram) ---
# La misma OPENROUTER_API_KEY de arriba. Default: x-ai/grok-4.3
# Se usa en /api/x/analyze (traer el hilo + clasificar) y en el monitoreo
# en vivo de X solo para BUSCAR posteos: título y sentimiento van por el
# clasificador compartido (LLM_PROVIDER, con CLAUDE_MODEL u OPENROUTER_MODEL).
# grok-4.1-fast está deprecado; xAI apunta a grok-4.3.
OPENROUTER_X_MODEL=x-ai/grok-4.3
#
# Alias opcional (si no seteás OPENROUTER_X_MODEL):
# XAI_MODEL=x-ai/grok-4.3
#
# Respaldo si NO hay OPENROUTER_API_KEY: API directa de xAI.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# --- Opcionales (tienen valores por defecto, podés dejarlos vacíos) ---

# Cuántos comentarios pedirle a Apify como máximo en un análisis (más = más caro y lento).
# Default 300, tope 500. Se cobra cada comentario devuelto: 300 son unos US$ 0,70 en Starter.
# En plan GRATUITO de Apify suele haber tope ~15 comentarios por post.
COMMENTS_LIMIT=300

# Cuántos comentarios de Instagram se analizan tras ordenar/deduplicar (commentSample.js).
# Default 300, tope 500. Se clasifican en tandas de 100 por llamada al modelo.
# Si hay más extraídos, se priorizan verificados y los de más likes.
COMMENTS_ANALYSIS_LIMIT=300

# El mismo tope para X, aparte: X manda todo el hilo en UNA llamada a Grok. Default 150.
# X_COMMENTS_ANALYSIS_LIMIT=150

# Costo LLM estimado en UI (USD por millón de tokens). Opcional: si están ambos,
# tienen prioridad sobre la tabla interna de Anthropic. Útil para OpenRouter u otros modelos.
# LLM_INPUT_USD_PER_MTOK=2
# LLM_OUTPUT_USD_PER_MTOK=8


# Puerto del servidor web local
PORT=3000

# En producción (Railway): NODE_ENV=production. Express deja de armar
# páginas de error con detalle y usa sus valores de producción. En la
# notebook se puede dejar sin definir.
# NODE_ENV=production

# ==========================================================================
# Login (allowlist + magic link) y sesión
# ==========================================================================
# La sesión vive en SQLite (tabla sessions) y se puede revocar: SESSION_SECRET
# ya no se usa (si quedó en tu .env, borralo).
# Minutos sin actividad que cortan la sesión (las consultas automáticas de la
# pantalla no cuentan como actividad). Entero positivo.
# SESSION_IDLE_MIN=30
# Horas desde el login que cortan la sesión aunque haya actividad.
# SESSION_MAX_HOURS=8

# URL pública de la app (sin barra final). Se usa para armar el link del mail.
# Local: http://localhost:3000   Prod: https://tu-dominio
# Con https:// además se mandan HSTS (180 días) y upgrade-insecure-requests
# en la CSP (src/httpSecurity.js).
APP_BASE_URL=http://localhost:3000

# Emails extra, separados por coma. Se suman a config/allowed-emails.txt
# (en Railway conviene usar solo esto, porque el .txt gitignored no viaja).
# Mismo formato que el archivo: email;rol, con rol lector (por defecto: ve
# todo, no gasta ni escribe) u operador (todo).
# ALLOWED_EMAILS=ana@buenosaires.gob.ar;operador,juan@buenosaires.gob.ar

# Si estás detrás de un proxy (Railway): 1. También se activa solo si
# APP_BASE_URL empieza con https://
# TRUST_PROXY=1

# ==========================================================================
# Monitoreo automático (detección de menciones)
# ==========================================================================

# --- SMTP para el mail del magic link de login ---
# Con Gmail: usá tu dirección @gmail.com como SMTP_USER, y en SMTP_PASS una
# "contraseña de aplicación" (NO tu contraseña normal, Gmail la bloquea para
# SMTP). Generala en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=listenapp.dgayd@gmail.com
SMTP_PASS=
# Remitente del mail: nombre a la vista y la cuenta propia de la app. Entre
# comillas, por los espacios y los signos < >.
SMTP_FROM="Social Listening · DGAYD <listenapp.dgayd@gmail.com>"

# Topes de posteos por tipo de fuente en cada corrida del monitoreo. En
# Instagram la detección va SOLO por las búsquedas por palabra clave (desde
# septiembre 2026: cuentas y hashtags no se consultan, son guía para el
# clasificador), así que el que importa es SEARCH_RESULTS_LIMIT: el tope
# BASE de cada búsqueda (se paga 0,0005 usd por resultado devuelto; pedir un
# tope más alto no cuesta). Con una ventana de N días sube N veces, hasta
# 10x. Desde noviembre 2026 el tope de cada término sube además según lo
# que ese término suele traer, y si una búsqueda igual lo llena se hace una
# segunda consulta (ver SEARCH_RESULTS_MAX y SEARCH_EXTRA_MAX_USD_PER_CYCLE,
# abajo). Ojo: el actor no devuelve los resultados por fecha, así que un
# tope lleno no deja afuera "lo más viejo" sino una parte de cada día. Los
# otros dos valen para X (cuentas y hashtags) y para el actor oficial
# (IG_ACTOR=apify: resultsLimit de cada corrida, se paga por resultado).
# Reemplazan a MONITOR_RESULTS_LIMIT, que ya no se usa: si sigue en tu .env
# y faltan estos, vale para cuentas y hashtags con un aviso en consola.
MONITOR_ACCOUNT_LIMIT=10
MONITOR_HASHTAG_LIMIT=30
SEARCH_RESULTS_LIMIT=100

# Tope MÁXIMO de resultados de una búsqueda (src/busquedaTope.js). El tope
# de cada término sale de su volumen medido (el doble de lo que trajo por
# hora en su mejor consulta reciente, por las horas que se piden), nunca
# menos que SEARCH_RESULTS_LIMIT ni más que esto. Entero, sin separador de
# miles (2.000 se rechaza). Una búsqueda con 2.000 resultados cuesta hasta
# 1,015 usd.
SEARCH_RESULTS_MAX=2000

# Si una búsqueda llena su tope se hace UNA segunda consulta de la misma
# ventana con 4 veces el tope ("prefiero pagar el excedente antes que perder
# publicaciones"). Este es el techo de gasto POR CORRIDA para esas segundas
# consultas (se aparta lo máximo que puede costar cada una): no recorta las
# consultas normales. Si una segunda consulta no entra, la búsqueda queda
# marcada "tope lleno" y la corrida, incompleta. 0 apaga las segundas
# consultas.
SEARCH_EXTRA_MAX_USD_PER_CYCLE=2

# Cuánto espera el monitoreo a las búsquedas (milisegundos; default 15 min,
# piso 1000). Es UNA espera para todas las búsquedas de la red en esa
# corrida, no una por búsqueda: la detección no dura más que esto. Lo que no
# terminó queda "esperando" con el id de su corrida de Apify y se levanta
# al empezar la corrida siguiente (no se pierde ni se paga dos veces). Una
# búsqueda de una ventana de varios días tarda de 7 a 13 minutos: con los
# 300 s de antes se cortaba, se cobraba y se perdía.
SEARCH_WAIT_MS=900000

# Tope de cada búsqueda EN APIFY (segundos; default 3600, piso 60): Apify la
# corta ahí, para que una que nadie espera no quede corriendo.
SEARCH_RUN_TIMEOUT_SECS=3600

# La búsqueda por palabra clave de Instagram devuelve los posteos SIN caption
# ni contadores, así que a los resultados nuevos se les pide el detalle antes
# de evaluarlos: un solo run por ciclo de apify/instagram-scraper con todas
# las URLs (se paga por resultado: 0,0023 usd por posteo en Starter), con
# cualquier IG_ACTOR. Este es el tope de posteos por ciclo (los más nuevos
# primero; el resto entra en el ciclo siguiente SOLO si la búsqueda lo
# vuelve a traer dentro de la ventana; si no, se perdió). Por eso es holgado:
# 100 (era 20) solo cuesta si hay volumen (0,0023 usd por posteo nuevo). Cada
# posteo se consulta una sola vez (tabla search_seen). 0 apaga el detalle:
# los resultados de búsqueda sin texto se descartan, como antes.
SEARCH_ENRICH_LIMIT=100

# Tope de posteos que clasifica una invocación del backfill
# (POST /api/monitoring/backfill-classification): una llamada al modelo por
# posteo, así que acota el gasto de un clic; el resto queda para la próxima.
# Una sola a la vez (con otra en curso responde 409). Entero positivo.
# BACKFILL_MAX=200

# Tope de posteos por fuente (cuenta, hashtag o keyword) en cada búsqueda del
# adapter de X (src/platforms/x.js, Grok). Default 30; el código no deja pasar
# de 50. MONITOR_RESULTS_LIMIT (Apify) no aplica a X.
X_MONITOR_RESULTS_LIMIT=30

# Cuántos posteos recientes traer por cuenta para calcular el benchmark
# (mediana de likes/comentarios propia de esa cuenta, ver src/accountStats.js).
# Con apidojo la consulta de perfil incluye 10 y cada uno de más cuesta
# APIDOJO_RATE_ITEM (15 posteos = 0,0075 usd); con apify cada uno es un
# resultado. También es lo que trae cada pasada del refresco de métricas en
# modo perfil (REFRESH_MODE=perfil; por URL no interviene).
BENCHMARK_POST_LIMIT=15

# Cuándo se recalcula el benchmark de una cuenta (ver src/accountStats.js):
# SOLO cuando aparece con un posteo nuevo en el monitoreo (detected_posts)
# y, además, nunca se calculó o ese posteo se detectó estos días o más
# después del último cálculo. Da igual si es trackeada o llegó por hashtag;
# una cuenta que no vuelve a aparecer conserva su mediana sin volver a
# pagarla. Es también la cadencia máxima con la que se refrescan los
# seguidores de una cuenta (van en la misma pasada): una cuenta que no
# reaparece no actualiza seguidores ni el tipo de sus posteos viejos. 30
# (era 90): así seguidores y mediana no quedan tres meses viejos; cuesta
# una consulta de perfil (0,0075 usd) por cuenta y por mes, solo para las
# que reaparecen con un posteo nuevo.
BENCHMARK_RECALC_DAYS=30

# Tope de cuentas que recalcula el ciclo automático de benchmark por
# corrida (ver refreshStaleAccountStats en src/accountStats.js). Si en un
# ciclo aparecen muchas cuentas con recálculo pendiente, esto escalona el
# gasto: las que quedan afuera siguen pendientes y salen en los ciclos
# siguientes, en orden de llegada, sin perderse. Con la detección por
# búsquedas casi cada posteo nuevo es de una cuenta distinta: con 10 la
# cola no se vaciaba y los posteos quedaban días "sin referencia"; 50 la
# vacía en un ciclo normal (cada cuenta es una consulta de perfil, 0,0075
# usd). Para vaciar un atraso a mano: node scripts/recalc-account-stats.js
# --pendientes
MAX_ACCOUNTS_PER_CYCLE=50

# Alcance de un posteo (alto / medio / bajo), ver src/reachRule.js. Likes y
# comentarios se miran por separado, cada uno contra la mediana de SU cuenta:
#
#   razón = (valor + colchón) / (mediana de la cuenta + colchón)
#
#   alto:  razón >= REACH_HIGH_RATIO y, además, valor >= piso
#   medio: razón >= REACH_MID_RATIO
#   bajo:  el resto (el posteo no se despega de lo normal de su cuenta)
#
# La etiqueta del posteo es la mejor de las dos: alto si likes o comentarios
# dan alto, bajo solo si los dos dan bajo. "Se despegaron" muestra los alto.
#
# El colchón frena a las cuentas chicas: contra una mediana de 2 likes, 100
# likes eran 50 veces lo habitual; con colchón 2000 son 1,05. Cuanto más
# grande el colchón, más diferencia hace falta. Con estos valores, una
# cuenta con mediana 0 llega a medio con 200 likes o 30 comentarios y a alto
# con 1000 likes o 150 comentarios; una cuenta grande se mide casi igual que
# sin colchón. El piso es el mínimo absoluto para ser alto: con estos
# colchones no llega a actuar (el colchón ya pide eso mismo) y empieza a
# contar si el colchón se achica o el piso se sube.
#
# Colchones y pisos: enteros, SIN separador de miles (2000, no 2.000). Los
# cortes aceptan punto o coma decimal, y el de medio tiene que ser menor que
# el de alto. Un valor mal escrito no deja arrancar la app. Los cambios
# valen desde el próximo arranque y no hay que recalcular nada: el alcance
# se calcula cada vez que se muestran los posteos.
REACH_LIKES_CUSHION=2000
REACH_LIKES_FLOOR=1000
REACH_COMMENTS_CUSHION=300
REACH_COMMENTS_FLOOR=150
REACH_HIGH_RATIO=1.5
REACH_MID_RATIO=1.1

# Cómo se refrescan likes/comments de los posteos YA detectados (ver
# src/metricsRefresh.js y openspec/changes/refresco-url):
#   url (default): cada publicación vencida se pide por su URL (/p/<code>/)
#     al actor oficial apify/instagram-scraper, el mismo camino del detalle
#     de búsqueda: un run por ciclo con todas las URLs (lotes de hasta 100),
#     0,0023 usd por posteo, decidido por publicación. Se actualiza
#     exactamente lo pedido; antes, por perfil, tres de cada cuatro posteos
#     se pagaban sin actualizarse (un posteo de 2 a 7 días ya no está entre
#     los últimos 15 del perfil).
#   perfil: lo anterior, sin cambios: una consulta de perfil por cuenta con
#     posteos vencidos (apidojo, BENCHMARK_POST_LIMIT posteos,
#     MAX_ACCOUNTS_PER_REFRESH cuentas). Para volver atrás sin tocar código.
# Un valor desconocido aborta el arranque.
REFRESH_MODE=url

# Tope de publicaciones pedidas por URL en cada ciclo (solo REFRESH_MODE=url).
# Cola por tramo (caliente, tibio, frío) y, dentro de cada tramo, lo más
# atrasado primero; lo que no entra queda para el ciclo siguiente y las
# marcas de pase de tibio y frío no avanzan hasta un pase completo. 150: el
# pase tibio diario más grande visto fue 125 posteos (entra entero); el pase
# frío semanal (278 a 339 posteos) se reparte en 2 o 3 ciclos seguidos.
# Techo por ciclo: 150 × 0,0023 = 0,345 usd.
REFRESH_MAX_POSTS=150

# Intentos SEGUIDOS en que el run termina bien y no devuelve el posteo
# (borrado o privado) antes de dejar de pedirlo (solo REFRESH_MODE=url).
# Queda anotado en detected_posts (refresh_misses, refresh_stopped_at) y en
# el log; una respuesta válida lo reanuda. Sus métricas quedan en el último
# valor conocido. Costo máximo por posteo borrado: 2 × 0,0023.
REFRESH_MISSES_TO_STOP=2

# Tramos del refresco de likes/comments de posteos YA detectados (ver
# src/metricsRefresh.js) — nunca re-detecta ni re-clasifica, solo actualiza
# esos dos números. Tres tramos por antigüedad del posteo (posted_at):
#   < REFRESH_HOT_HOURS               -> cada REFRESH_HOT_EVERY_HOURS (por posteo)
#   REFRESH_HOT_HOURS a REFRESH_WARM_DAYS -> cada REFRESH_WARM_EVERY_HOURS
#   REFRESH_WARM_DAYS a REFRESH_COLD_MAX_DAYS -> barrido cada REFRESH_COLD_EVERY_DAYS
#   más de REFRESH_COLD_MAX_DAYS      -> congelado, no se vuelve a tocar
# El tramo caliente se refrescaba en CADA ciclo (cada 4 h): era más de la
# mitad del gasto en Apify sin traer ninguna publicación nueva. Con 12 h,
# cada posteo de menos de 48 h se refresca dos veces por día; un posteo
# recién detectado entra cuando pasan 12 h desde su detección (por URL; por
# perfil, en el ciclo siguiente). Para volver a lo de antes:
# REFRESH_HOT_EVERY_HOURS=1 (todo ciclo lo encuentra vencido).
REFRESH_HOT_HOURS=48
REFRESH_HOT_EVERY_HOURS=12
REFRESH_WARM_DAYS=7
REFRESH_WARM_EVERY_HOURS=24
REFRESH_COLD_EVERY_DAYS=7
REFRESH_COLD_MAX_DAYS=60

# Solo REFRESH_MODE=perfil. Tope de cuentas por corrida del refresco de
# métricas (agrupa por cuenta,
# no por posteo — una sola llamada a Apify cubre todos los posteos
# pendientes de esa cuenta). Prioriza las de posteos más recientes. Si deja
# cuentas afuera, las marcas de pase del tramo tibio y frío no avanzan: el
# tramo se vuelve a evaluar en el próximo ciclo y se retoma solo lo que
# faltaba (cada posteo ya refrescado queda fuera por su cadencia). 100 (era
# 30: el tramo caliente solo ya lo llenaba y el tibio y el frío casi nunca
# entraban); cada cuenta es una consulta de perfil (0,0075 usd).
MAX_ACCOUNTS_PER_REFRESH=100

# A partir de qué salto en likes/comentarios se loguea como "SALTO" en
# src/metricsRefresh.js (ej. reels que explotan tarde). VIRAL_JUMP_FACTOR es
# el múltiplo sobre el valor anterior (3 = se triplicó); VIRAL_JUMP_FROM_ZERO_MIN
# es el piso absoluto para el caso "pasó de 0 a N", donde un múltiplo no se
# puede calcular.
VIRAL_JUMP_FACTOR=3
VIRAL_JUMP_FROM_ZERO_MIN=50

# Ventana de detección de una fuente que todavía no tiene ninguna detección
# exitosa (una búsqueda recién agregada, o la primera corrida en esta base):
# "1 day" = un día hacia atrás. Después, cada fuente retoma desde SU última
# detección exitosa (ver MONITOR_MIN_WINDOW y MONITOR_LOOKBACK_MAX, abajo).
# Formato libre: "1 day", "6 hours", "2 weeks" (se redondea a días enteros).
MONITOR_LOOKBACK=1 day

# Lo MÍNIMO que mira hacia atrás cada consulta de detección, aunque esa
# fuente haya respondido hace un rato (default 1 día: con el cron al día,
# cada búsqueda mira 24 h, como siempre). Subirlo hace cada búsqueda más
# honda: trae más de lo publicado, tarda más (de 7 a 13 minutos con 7 días)
# y cuesta más (se paga cada resultado, también los ya vistos, que no se
# vuelven a clasificar). Medido el 16/11/2026: con 1 día el actor devuelve
# entre el 3 y el 20 % de lo publicado en esas 24 h; con 7 días, cerca del
# 70 % por pasada.
MONITOR_MIN_WINDOW=1 day

# Corridas hondas (src/deepRun.js). Una búsqueda de 7 días trae mucho más de
# lo publicado que una de 1 día, pero cuesta bastante más (se paga cada
# resultado, también los ya vistos), así que se elige en qué horas del cron
# la corrida es honda. En una corrida honda la ventana mínima de TODAS las
# búsquedas es MONITOR_DEEP_WINDOW en vez de MONITOR_MIN_WINDOW. Con las dos
# variables comentadas o vacías no hay corridas hondas y todo queda como
# siempre.
#   - MONITOR_DEEP_HOURS: horas (0 a 23, separadas por coma, hora local del
#     server, como MONITOR_CRON) en las que la corrida programada es honda.
#     Cambiar cuántas hondas hay por día es cambiar este valor: "8" es una,
#     "8,16" dos, "8,12,16,20" todas. Una hora que el cron no dispara se
#     avisa al arrancar.
#   - MONITOR_DEEP_WINDOW: la ventana honda, en el formato de MONITOR_LOOKBACK
#     (default "7 days" si están las horas).
# Si pasaron más de 24 h desde la última corrida honda terminada (la máquina
# estuvo apagada, o todavía no hubo ninguna), la próxima corrida programada
# es honda aunque no sea su hora. "Actualizar ahora" es siempre corta.
# Cada corrida deja en el log si es honda o corta y el costo estimado de sus
# búsquedas. Medido en noviembre 2026 con 8 búsquedas: una corrida honda,
# entre 1,2 y 1,5 usd; una corta, unos 0,13. Con hondas a las 8 y a las 16 y
# cortas a las 12 y a las 20, entre 80 y 110 usd por mes en búsquedas (con
# las cuatro cortas, unos 16 a 20), más lo que cueste clasificar lo nuevo.
# Cada honda diaria son unos 37 a 41 usd por mes.
# MONITOR_DEEP_HOURS=8,16
# MONITOR_DEEP_WINDOW=7 days

# Techo de la ventana de detección (src/monitor.js, detectionWindowFor).
# La ventana es POR FUENTE (cada búsqueda de Instagram; en X, cada cuenta,
# hashtag y keyword): va desde la última detección exitosa DE ESA FUENTE
# hasta ahora — así, si una búsqueda falla o el server estuvo apagado, lo
# publicado en el medio se vuelve a pedir. Este valor es el TECHO: nunca se
# pide más atrás que esto, ni siquiera tras una caída larga (si recorta,
# queda registrado desde cuándo no se pidió). Sin detección previa se usa
# MONITOR_LOOKBACK (1 día), no el techo. En el caso normal (cron al día) la
# ventana da "1 day" — este valor solo se nota después de una caída real.
# Si la ventana de una fuente supera 1 día, su tope (SEARCH_RESULTS_LIMIT,
# MONITOR_ACCOUNT_LIMIT o MONITOR_HASHTAG_LIMIT) sube proporcionalmente
# (factor = días de ventana, tope 10x el configurado — ver
# RAISE_LIMIT_CEILING_FACTOR en monitor.js) para no perder posteos por el
# tope de cantidad en vez de por fecha: el excedente se paga, no se corta.
MONITOR_LOOKBACK_MAX=30 days

# Expresión cron de cuándo correr el monitoreo (hora local del server). Por
# defecto a las 8, 12, 16 y 20 (sin las corridas de 0 y 4). Formatos que
# entiende el pie de página de la app: lista de horas fijas ("8,12,16,20"),
# paso ("*/4") o "*" (cada hora).
MONITOR_CRON=0 8,12,16,20 * * *

# Plataformas que corre el ciclo AUTOMÁTICO (lista separada por comas, ids
# del registro de src/platforms/: instagram, x). X está en stand by (su
# detección por Grok no funciona hoy), así que por defecto el cron corre
# solo Instagram. Para volver a sumarla: MONITOR_PLATFORMS=instagram,x. Un
# id desconocido se ignora con aviso; si no queda ninguno válido, se usa el
# default. "Actualizar ahora" no mira esto: corre la plataforma de la solapa
# que apretó el botón, X incluida.
MONITOR_PLATFORMS=instagram

# Fotos de los posteos de Instagram (tarjetas del Feed y pop-up "Ver más").
# Al guardar un posteo nuevo y en el refresco por URL, la app baja la imagen
# cuyo link ya vino en esa respuesta (reel: la portada; carrusel: la primera
# imagen; nunca videos) y guarda dos copias JPEG en data/media/instagram/:
# una miniatura de 360 px de ancho y una imagen de 900 px de lado largo
# (hasta unos 125 KB por posteo entre las dos). No le pide nada nuevo a
# Apify. Solo baja de los servidores de imágenes de Instagram y Facebook
# (*.cdninstagram.com, *.fbcdn.net), solo JPEG, PNG o WebP, con tope de 15 MB
# y de 15 segundos por imagen y de 2 minutos por tanda, y una foto que falla
# nunca frena el ciclo: lo que no sale queda pendiente y se reintenta al
# empezar el ciclo siguiente, con el link ya guardado. 0 apaga las descargas
# y los reintentos: lo ya guardado se sigue viendo y no se borra nada. Vacío
# o cualquier otro valor las deja prendidas. Con REFRESH_MODE=perfil el
# refresco no baja fotos: solo las reciben los posteos nuevos.
POST_IMAGES=1

# Windows: mientras la app corre, el server lanza un PowerShell hijo
# (scripts/keep-awake.ps1) que le pide a Windows no suspender el sistema ni
# apagar la pantalla (SetThreadExecutionState, sin permisos de
# administrador). Una notebook con Modern Standby entra en reposo apenas se
# apaga la pantalla y frena la app. Al terminar el server, el hijo sale solo
# y Windows vuelve a su política normal. 0 lo apaga. En otros sistemas no
# hace nada.
KEEP_AWAKE=1

# Geocoding de reclamos: USIG (servicios.usig.buenosaires.gob.ar), sin API key.
