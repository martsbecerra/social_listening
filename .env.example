# ==========================================================================
# Copiá este archivo como ".env" (sin ".example") y completá los valores.
# NUNCA subas el .env a git ni lo compartas: contiene tus claves secretas.
# ==========================================================================

# Token de la API de Apify (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=

# Cuántas corridas de Apify puede tener esta app en vuelo a la vez. El plan
# Free permite 5 Actor runs simultáneos y la detección del monitoreo lanza
# todas las fuentes de Instagram juntas: sin este tope, con 12 cuentas +
# hashtags varias fallaban con 402 concurrent-runs-limit-exceeded. TODAS las
# llamadas a Apify (detección, benchmark, refresco, análisis a demanda,
# validación de cuentas) pasan por la misma cola (src/apify.js). 3 deja
# margen para que dos cosas corran a la vez sin llegar a 5; con un plan que
# permita más runs, subirlo.
APIFY_MAX_CONCURRENT=3

# Si igual llega un 402 por runs simultáneos (otro proceso con el mismo
# token, o el tope de arriba demasiado alto), esa llamada espera esto (en
# milisegundos) y reintenta UNA vez antes de fallar. Opcional.
APIFY_RETRY_DELAY_MS=5000

# Timeout de seguridad por llamada a Apify (milisegundos): si runActorSync
# no termina en este plazo (arrancar el run, esperar, bajar el dataset),
# se corta con code TIMEOUT, se libera el cupo del limitador y esa cuenta u
# hashtag queda sin datos este ciclo, sin colgar el resto (un ciclo real se
# colgó ~30 min sin esto y hubo que matar el proceso a mano). Se aplica a
# cada intento por separado (el inicial y el único reintento por 402). Piso
# de 1000ms: nunca se deja en un valor tan bajo que toda llamada falle sola.
APIFY_CALL_TIMEOUT_MS=120000

# Cuánto cobra Apify por cada 1000 resultados devueltos, según el plan
# (actualizar si Apify cambia los precios). Con esto la app mide lo que
# gasta de verdad: cada llamada queda en la tabla apify_calls y cada ciclo
# en monitoring_runs (ver src/apifyCost.js), y `npm run costo` o
# GET /api/monitoring/costs muestran el gasto con las tres tarifas a la vez.
APIFY_RATE_FREE=2.70
APIFY_RATE_STARTER=2.30
APIFY_RATE_SCALE=1.90
# Plan activo (free | starter | scale): con su tarifa se llena la columna usd
# de apify_calls y monitoring_runs y el total de la línea "[costo] ciclo #N".
APIFY_PLAN=starter

# Actor de Apify para el MONITOREO de Instagram (detección, benchmark,
# refresco de métricas, validación de cuentas y hashtags, script de
# recálculo). Ver src/platforms/igActor.js.
#   apidojo (default) -> apidojo/instagram-scraper-api: cobra por consulta
#                        con posteos incluidos (APIDOJO_* abajo), trae los
#                        seguidores en cada posteo y busca por palabra clave.
#   apify             -> apify/instagram-scraper, el de siempre: cobra por
#                        resultado (APIFY_RATE_*), sin búsqueda por palabra
#                        clave. Con este valor todo funciona como antes.
# El ANÁLISIS de una publicación (comentarios) sigue siempre con
# apify/instagram-scraper: el otro actor no devuelve comentarios. Un valor
# desconocido aborta el arranque.
IG_ACTOR=apidojo

# Qué cobra apidojo por cada consulta (USD), cuántos posteos incluye cada
# una y cuánto cuesta cada posteo de más (USD). Con esto se estima el usd
# de cada llamada; el costo REAL lo devuelve Apify (ver APIFY_REAL_COST).
APIDOJO_RATE_USER=0.005
APIDOJO_RATE_HASHTAG=0.015
APIDOJO_RATE_SEARCH=0.015
APIDOJO_RATE_POST=0.005
APIDOJO_RATE_ITEM=0.0005
APIDOJO_INCLUDED_USER=10
APIDOJO_INCLUDED_HASHTAG=30
APIDOJO_INCLUDED_SEARCH=20

# Costo real por run (solo con el actor apidojo): las llamadas van por el
# flujo asincrónico de Apify (arrancar el run, esperar y bajar sus items:
# dos o tres requests en vez de una, sin costo extra) para guardar el id
# del run. Como Apify asienta el cobro con demora, usd_real se concilia
# después: al cerrar cada ciclo se releen (gratis) los runs de las llamadas
# de más de 10 minutos, y `node scripts/costo-apify.js --conciliar` lo hace
# a mano. Los reportes prefieren usd_real al estimado. 0 lo apaga y vuelve
# al endpoint sincrónico (sin run id ni costo real).
APIFY_REAL_COST=1

# ==========================================================================
# Proveedor del LLM (análisis, clasificador del monitoreo, reclamos, importador)
# --------------------------------------------------------------------------
# El ANÁLISIS de una publicación de X usa Grok (OPENROUTER_X_MODEL) aparte;
# todo lo demás (análisis de Instagram, clasificación del monitoreo de todas
# las redes, subcategoría de reclamos, importador) usa este proveedor con UN
# solo modelo.
# Valores válidos: anthropic | openrouter. Cualquier otro valor (o un typo)
# aborta el arranque en vez de caer en un default silencioso.
#
# El modelo es el mismo en ambos proveedores — sólo cambia el formato del
# identificador: OpenRouter prefija con el proveedor (verificado contra
# https://openrouter.ai/api/v1/models):
#
#   anthropic          | openrouter
#   -------------------+---------------------------------
#   claude-sonnet-5    | anthropic/claude-sonnet-5
#
# Ese es el default del código (src/llm/providerConfig.js): si dejás la
# variable de modelo vacía, cambiar de proveedor NO cambia qué modelo se usa.
# Las variables de abajo sólo hacen falta para pisarlo.
#
# CLASSIFIER_MODEL y OPENROUTER_CLASSIFIER_MODEL (el modelo clasificador
# aparte, Haiku, de antes de septiembre 2026) ya no existen: si siguen en tu
# .env se ignoran, con un aviso al arrancar.
# ==========================================================================
LLM_PROVIDER=anthropic

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
# Clave: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo (análisis de publicación y clasificador del monitoreo). Recomendado: claude-sonnet-5.
#   - claude-haiku-4-5  -> más económico (puede perder matices/ironía)
#   - claude-sonnet-5   -> recomendado
#   - claude-opus-4-8   -> máxima calidad (más caro)
CLAUDE_MODEL=claude-sonnet-5

# --- OpenRouter (si LLM_PROVIDER=openrouter) ---
# Clave: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Base de la API. OpenRouter es compatible con OpenAI, así que esto también
# sirve para apuntar a cualquier otro gateway compatible.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo en OpenRouter (equivalente a CLAUDE_MODEL: análisis y clasificador
# del monitoreo). Debe soportar structured outputs — verificalo en
# https://openrouter.ai/models (el modelo tiene que listar
# "structured_outputs"). Vacío = el default de arriba, anthropic/claude-sonnet-5.
OPENROUTER_MODEL=

# Headers que OpenRouter recomienda para identificar la app (opcionales:
# sirven para los rankings de openrouter.ai). Si los dejás vacíos, el código
# manda X-Title: "Social Listening App" y HTTP-Referer: http://localhost:PORT.
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=

# --- Grok para X (OpenRouter; no pisa Instagram) ---
# La misma OPENROUTER_API_KEY de arriba. Default: x-ai/grok-4.3
# Se usa en /api/x/analyze (traer el hilo + clasificar) y en el monitoreo
# en vivo de X solo para BUSCAR posteos: título y sentimiento van por el
# clasificador compartido (LLM_PROVIDER, con CLAUDE_MODEL u OPENROUTER_MODEL).
# grok-4.1-fast está deprecado; xAI apunta a grok-4.3.
OPENROUTER_X_MODEL=x-ai/grok-4.3
#
# Alias opcional (si no seteás OPENROUTER_X_MODEL):
# XAI_MODEL=x-ai/grok-4.3
#
# Respaldo si NO hay OPENROUTER_API_KEY: API directa de xAI.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# --- Opcionales (tienen valores por defecto, podés dejarlos vacíos) ---

# Cuántos comentarios pedirle a Apify como máximo (más = más caro y lento).
# En plan GRATUITO de Apify suele haber tope ~15 comentarios por post; plan pago permite más (actor: máx. ~50/post).
COMMENTS_LIMIT=100

# Cuántos comentarios se envían a Claude tras ordenar/deduplicar (commentSample.js).
# Si hay más extraídos, se priorizan verificados y los de más likes. Default: 150.
COMMENTS_ANALYSIS_LIMIT=150

# Costo LLM estimado en UI (USD por millón de tokens). Opcional: si están ambos,
# tienen prioridad sobre la tabla interna de Anthropic. Útil para OpenRouter u otros modelos.
# LLM_INPUT_USD_PER_MTOK=2
# LLM_OUTPUT_USD_PER_MTOK=8

# Ruta al JSON de @usuario → accountType (default: data/account-types.json en el proyecto).
# ACCOUNT_REGISTRY_PATH=

# Puerto del servidor web local
PORT=3000

# ==========================================================================
# Login (allowlist + magic link)
# ==========================================================================
# String largo y aleatorio para firmar la cookie de sesión.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública de la app (sin barra final). Se usa para armar el link del mail.
# Local: http://localhost:3000   Prod: https://tu-dominio
APP_BASE_URL=http://localhost:3000

# Emails extra, separados por coma. Se suman a config/allowed-emails.txt
# (en Railway conviene usar solo esto, porque el .txt gitignored no viaja).
# ALLOWED_EMAILS=ana@buenosaires.gob.ar,juan@buenosaires.gob.ar

# Si estás detrás de un proxy (Railway): 1. También se activa solo si
# APP_BASE_URL empieza con https://
# TRUST_PROXY=1

# ==========================================================================
# Monitoreo automático (detección de menciones)
# ==========================================================================

# --- SMTP para el mail del magic link de login ---
# Con Gmail: usá tu dirección @gmail.com como SMTP_USER, y en SMTP_PASS una
# "contraseña de aplicación" (NO tu contraseña normal, Gmail la bloquea para
# SMTP). Generala en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=twallet@gmail.com
SMTP_PASS=
SMTP_FROM=SL

# Topes de posteos por tipo de fuente en cada corrida del monitoreo. En
# Instagram la detección va SOLO por las búsquedas por palabra clave (desde
# septiembre 2026: cuentas y hashtags no se consultan, son guía para el
# clasificador), así que el que importa es SEARCH_RESULTS_LIMIT: la búsqueda
# de apidojo incluye 20 posteos y por encima se cobra 0,0005 usd cada uno.
# Es un tope de seguridad por día de ventana (con una ventana de N días sube
# N veces, hasta 5x): si una búsqueda lo llena, el log avisa
# ("[apidojo] la búsqueda ... devolvió N posteos, el tope"); subilo para
# pagar el excedente en vez de cortar. 100 (era 50): en la práctica no se
# llena (ninguna búsqueda pasó de 7 resultados en septiembre 2026) y solo
# cuesta si hay resultados, así que va holgado para un día viral. Los otros
# dos valen para X (cuentas y hashtags) y para el actor oficial
# (IG_ACTOR=apify: resultsLimit de cada corrida, se paga por resultado).
# Reemplazan a MONITOR_RESULTS_LIMIT, que ya no se usa: si sigue en tu .env
# y faltan estos, vale para cuentas y hashtags con un aviso en consola.
MONITOR_ACCOUNT_LIMIT=10
MONITOR_HASHTAG_LIMIT=30
SEARCH_RESULTS_LIMIT=100

# La búsqueda por palabra clave de Instagram devuelve los posteos SIN caption
# ni contadores, así que a los resultados nuevos se les pide el detalle antes
# de evaluarlos: un solo run por ciclo de apify/instagram-scraper con todas
# las URLs (se paga por resultado: 0,0023 usd por posteo en Starter), con
# cualquier IG_ACTOR. Este es el tope de posteos por ciclo (los más nuevos
# primero; el resto entra en el ciclo siguiente SOLO si la búsqueda lo
# vuelve a traer dentro de la ventana; si no, se perdió). Por eso es holgado:
# 100 (era 20) solo cuesta si hay volumen (0,0023 usd por posteo nuevo). Cada
# posteo se consulta una sola vez (tabla search_seen). 0 apaga el detalle:
# los resultados de búsqueda sin texto se descartan, como antes.
SEARCH_ENRICH_LIMIT=100

# Tope de posteos por fuente (cuenta, hashtag o keyword) en cada búsqueda del
# adapter de X (src/platforms/x.js, Grok). Default 30; el código no deja pasar
# de 50. MONITOR_RESULTS_LIMIT (Apify) no aplica a X.
X_MONITOR_RESULTS_LIMIT=30

# Cuántos posteos recientes traer por cuenta para calcular el benchmark
# (mediana de likes/comentarios propia de esa cuenta, ver src/accountStats.js).
# Con apidojo la consulta de perfil incluye 10 y cada uno de más cuesta
# APIDOJO_RATE_ITEM (15 posteos = 0,0075 usd); con apify cada uno es un
# resultado. También es lo que trae cada pasada del refresco de métricas.
BENCHMARK_POST_LIMIT=15

# Cuándo se recalcula el benchmark de una cuenta (ver src/accountStats.js):
# SOLO cuando aparece con un posteo nuevo en el monitoreo (detected_posts)
# y, además, nunca se calculó o ese posteo se detectó estos días o más
# después del último cálculo. Da igual si es trackeada o llegó por hashtag;
# una cuenta que no vuelve a aparecer conserva su mediana sin volver a
# pagarla. Es también la cadencia máxima con la que se refrescan los
# seguidores de una cuenta (van en la misma pasada): una cuenta que no
# reaparece no actualiza seguidores ni el tipo de sus posteos viejos.
BENCHMARK_RECALC_DAYS=90

# Tope de cuentas que recalcula el ciclo automático de benchmark por
# corrida (ver refreshStaleAccountStats en src/accountStats.js). Si en un
# ciclo aparecen muchas cuentas con recálculo pendiente, esto escalona el
# gasto: las que quedan afuera siguen pendientes y salen en los ciclos
# siguientes, en orden de llegada, sin perderse. Con la detección por
# búsquedas casi cada posteo nuevo es de una cuenta distinta: con 10 la
# cola no se vaciaba y los posteos quedaban días "sin referencia"; 50 la
# vacía en un ciclo normal (cada cuenta es una consulta de perfil, 0,0075
# usd). Para vaciar un atraso a mano: node scripts/recalc-account-stats.js
# --pendientes
MAX_ACCOUNTS_PER_CYCLE=50

# Refresco periódico de likes/comments de posteos YA detectados (ver
# src/metricsRefresh.js) — nunca re-detecta ni re-clasifica, solo actualiza
# esos dos números. Tres tramos por antigüedad del posteo (posted_at):
#   < REFRESH_HOT_HOURS               -> cada REFRESH_HOT_EVERY_HOURS (por posteo)
#   REFRESH_HOT_HOURS a REFRESH_WARM_DAYS -> cada REFRESH_WARM_EVERY_HOURS
#   REFRESH_WARM_DAYS a REFRESH_COLD_MAX_DAYS -> barrido cada REFRESH_COLD_EVERY_DAYS
#   más de REFRESH_COLD_MAX_DAYS      -> congelado, no se vuelve a tocar
# El tramo caliente se refrescaba en CADA ciclo (cada 4 h): era más de la
# mitad del gasto en Apify sin traer ninguna publicación nueva. Con 12 h,
# cada posteo de menos de 48 h se refresca dos veces por día; un posteo
# recién detectado entra en el ciclo siguiente. Para volver a lo de antes:
# REFRESH_HOT_EVERY_HOURS=1 (todo ciclo lo encuentra vencido).
REFRESH_HOT_HOURS=48
REFRESH_HOT_EVERY_HOURS=12
REFRESH_WARM_DAYS=7
REFRESH_WARM_EVERY_HOURS=24
REFRESH_COLD_EVERY_DAYS=7
REFRESH_COLD_MAX_DAYS=60

# Tope de cuentas por corrida del refresco de métricas (agrupa por cuenta,
# no por posteo — una sola llamada a Apify cubre todos los posteos
# pendientes de esa cuenta). Prioriza las de posteos más recientes. Si deja
# cuentas afuera, las marcas de pase del tramo tibio y frío no avanzan: el
# tramo se vuelve a evaluar en el próximo ciclo y se retoma solo lo que
# faltaba (cada posteo ya refrescado queda fuera por su cadencia). 100 (era
# 30: el tramo caliente solo ya lo llenaba y el tibio y el frío casi nunca
# entraban); cada cuenta es una consulta de perfil (0,0075 usd).
MAX_ACCOUNTS_PER_REFRESH=100

# A partir de qué salto en likes/comentarios se loguea como "SALTO" en
# src/metricsRefresh.js (ej. reels que explotan tarde). VIRAL_JUMP_FACTOR es
# el múltiplo sobre el valor anterior (3 = se triplicó); VIRAL_JUMP_FROM_ZERO_MIN
# es el piso absoluto para el caso "pasó de 0 a N", donde un múltiplo no se
# puede calcular.
VIRAL_JUMP_FACTOR=3
VIRAL_JUMP_FROM_ZERO_MIN=50

# Ventana de detección cuando NO hay ninguna corrida previa registrada (la
# primera vez que corre el monitoreo en esta base): "1 day" = un día hacia
# atrás. Con corrida previa, la ventana es dinámica (ver MONITOR_LOOKBACK_MAX
# abajo). También es la ventana fija de las keywords de X (search de Grok).
# Formato libre: "1 day", "6 hours", "2 weeks" (se redondea a días enteros).
MONITOR_LOOKBACK=1 day

# Techo de la ventana DINÁMICA de detección (src/monitor.js,
# detectionWindowFor; en Instagram la usan las búsquedas por palabra clave,
# en X cuentas y hashtags): la ventana va desde el fin de la última
# detección exitosa de esa plataforma hasta ahora — así, si el server estuvo
# apagado, lo publicado en el medio no se pierde. Este valor es el TECHO:
# nunca se pide más atrás que esto, ni siquiera tras una caída larga, para
# no disparar una recuperación gigante (y su costo). Sin corrida previa se
# usa MONITOR_LOOKBACK (1 día), no el techo. En el caso normal (cron al día)
# la ventana da "1 day" — este valor solo se nota después de una caída real.
# Si la ventana calculada supera 1 día, SEARCH_RESULTS_LIMIT,
# MONITOR_ACCOUNT_LIMIT y MONITOR_HASHTAG_LIMIT de esa corrida suben
# proporcionalmente (factor = días de ventana, tope 5x el configurado — ver
# RAISE_LIMIT_CEILING_FACTOR en monitor.js) para no perder posteos por el
# tope de cantidad en vez de por fecha: el excedente se paga, no se corta.
MONITOR_LOOKBACK_MAX=7 days

# Expresión cron de cuándo correr el monitoreo (hora local del server). Por
# defecto a las 8, 12, 16 y 20 (sin las corridas de 0 y 4). Formatos que
# entiende el pie de página de la app: lista de horas fijas ("8,12,16,20"),
# paso ("*/4") o "*" (cada hora).
MONITOR_CRON=0 8,12,16,20 * * *

# Plataformas que corre el ciclo AUTOMÁTICO (lista separada por comas, ids
# del registro de src/platforms/: instagram, x). X está en stand by (su
# detección por Grok no funciona hoy), así que por defecto el cron corre
# solo Instagram. Para volver a sumarla: MONITOR_PLATFORMS=instagram,x. Un
# id desconocido se ignora con aviso; si no queda ninguno válido, se usa el
# default. "Actualizar ahora" no mira esto: corre la plataforma de la solapa
# que apretó el botón, X incluida.
MONITOR_PLATFORMS=instagram

# Geocoding de reclamos: USIG (servicios.usig.buenosaires.gob.ar), sin API key.
